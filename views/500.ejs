<%- include('partials/header', { title: `${status} – Ошибка запроса` }) %>
<div class="page-container page-center">
  <div class="error-box error-box-500">
    <div class="error-code error-code-500"><%= status %></div>
    <h1 class="error-title"><%= status >= 500 ? 'Хранилище временно недоступно' : 'Запрос не выполнен' %></h1>
    <p class="error-text"><%= message %></p>
    <p class="error-text">Сервер продолжает работать. После устранения причины повторите действие.</p>
    <p class="form-hint">Номер обращения: <%= requestId %></p>
    <div class="error-actions">
      <a href="/<%= authQuery %>" class="btn btn-primary">На главную</a>
      <a href="/add<%= authQuery %>" class="btn btn-secondary">К форме</a>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
